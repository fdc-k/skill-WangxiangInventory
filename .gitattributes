# ============================================================================
# 换行符规则
# ----------------------------------------------------------------------------
# 为什么需要这个文件：
#   * Windows 的 .bat 批处理文件如果是 LF 换行，某些 cmd 版本会执行异常；
#   * macOS/Linux 的 .sh / .command 如果是 CRLF 换行，会报 "bad interpreter"。
# 如果不写死规则，git 在不同系统 clone 时会自动转换，把脚本弄坏。
# ============================================================================

* text=auto

# Windows 批处理：必须 CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# macOS / Linux 脚本：必须 LF
*.sh      text eol=lf
*.command text eol=lf

# CSV 用 CRLF，Excel 打开最稳
*.csv text eol=crlf

# 二进制文件：不要做任何转换
*.pdf   binary
*.xlsx  binary
*.xls   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.woff  binary
*.woff2 binary
